[Unit]
Description=HRT1 official policy adapter on L20 localhost:16010
After=network-online.target pi05-goai10000.service
Wants=network-online.target
Requires=pi05-goai10000.service

[Service]
Type=simple
WorkingDirectory=/opt/goai/src/XPolicyLab-pi05
Environment=PYTHONPATH=/opt/goai/src:/opt/goai/src/XPolicyLab-pi05
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/goai/src/XPolicyLab-pi05/policy/Pi_05/openpi/.venv/bin/python /opt/goai/src/XPolicyLab-pi05/setup_policy_server.py --config_path /opt/goai/pi05/config/deploy.hrt1-l20.yml
Restart=on-failure
RestartSec=5
StandardOutput=append:/opt/goai/logs/hrt1-l20/policy_adapter.log
StandardError=append:/opt/goai/logs/hrt1-l20/policy_adapter.log

[Install]
WantedBy=multi-user.target
